{
  "name": "@yueli/foundation-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.18.x",
    "pnpm": "10.28.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ],
    "overrides": {
      "@iconify/collections@1.0.733": "1.0.732",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.7": "5.0.9",
      "@nuxt/devtools@3.2.4": "3.3.1",
      "dompurify@3.4.12": "3.4.13",
      "esbuild@0.27.7": "0.28.1",
      "fast-uri@3.1.4": "3.1.6",
      "nanoid@3.3.16": "3.3.17",
      "postcss@8.5.21": "8.5.26",
      "tar@7.5.20": "7.5.21",
      "undici@8.8.0": "8.9.0"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:js": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:go": "cd go && go test ./..."
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
