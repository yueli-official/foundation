{
  "name": "@yueli/foundation-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.18.x",
    "pnpm": "10.28.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:js": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:go": "cd go && go test ./..."
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
