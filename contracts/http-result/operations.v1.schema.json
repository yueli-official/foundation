{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yueli.dev/foundation/contracts/http-operations.v1.schema.json",
  "title": "Yueli HTTP operations v1",
  "type": "object",
  "required": ["schemaVersion", "namespace", "operations"],
  "properties": {
    "schemaVersion": { "const": "http.yueli.dev/operations/v1" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "success": {
      "type": "object",
      "required": ["status", "kind"],
      "properties": {
        "status": { "type": "integer", "minimum": 200, "maximum": 399 },
        "kind": {
          "enum": [
            "resource",
            "collection",
            "page",
            "cursorPage",
            "operation",
            "empty",
            "binary",
            "redirect"
          ]
        },
        "schemaRef": { "type": "string", "minLength": 1, "maxLength": 2048 }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["id", "method", "path", "success"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9._-]{1,127}$" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "maxLength": 2048 },
        "failureProtocol": {
          "enum": ["problem", "oauth"],
          "default": "problem"
        },
        "success": { "$ref": "#/$defs/success" },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:(?:[._-][a-z0-9]+)+)?$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
