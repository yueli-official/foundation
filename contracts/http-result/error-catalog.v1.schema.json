{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yueli.dev/foundation/contracts/error-catalog.v1.schema.json",
  "title": "Yueli public error catalog v1",
  "type": "object",
  "required": ["schemaVersion", "namespace", "errors"],
  "properties": {
    "schemaVersion": { "const": "errors.yueli.dev/catalog/v1" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "string[]",
            "integer[]",
            "number[]",
            "boolean[]"
          ]
        },
        "required": { "type": "boolean", "default": false },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 32 }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "status", "messageKey"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "goName": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "maxLength": 128
        },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "messageKey": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9._-]+$",
          "maxLength": 160
        },
        "recoveryKey": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9._-]+$",
          "maxLength": 160
        },
        "params": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "violations": {
          "enum": ["forbidden", "optional", "required"],
          "default": "forbidden"
        }
      },
      "additionalProperties": false
    }
  }
}
