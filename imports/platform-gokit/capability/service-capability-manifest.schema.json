{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.yueli.dev/schemas/service-capability-manifest.v1.schema.json",
  "title": "Service Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "service", "generatedAt", "redaction", "capabilities", "providers", "links"],
  "properties": {
    "apiVersion": {
      "const": "platform.yueli.dev/service-capability-manifest/v1"
    },
    "kind": {
      "const": "ServiceCapabilityManifest"
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "capabilityKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_-]*)+$"
    },
    "configuration": {
      "type": "string",
      "enum": ["missing", "partial", "complete"]
    },
    "enablement": {
      "type": "string",
      "enum": ["enabled", "disabled"]
    },
    "health": {
      "type": "string",
      "enum": ["unknown", "healthy", "degraded", "unhealthy"]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "buildSha", "deployment"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "buildSha": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "version"],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "state", "secret"],
      "properties": {
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "type": "string",
          "enum": ["present", "missing"]
        },
        "secret": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rotatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rel", "href"],
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "pattern": "^/([^/?#][^?#]*)?$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "contractVersion",
        "support",
        "configuration",
        "enablement",
        "health",
        "effective",
        "operations",
        "requiredConfig",
        "links"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/capabilityKey"
        },
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "type": "string",
          "enum": ["supported", "unsupported"]
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "enablement": {
          "$ref": "#/$defs/enablement"
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "effective": {
          "type": "boolean"
        },
        "adapter": {
          "$ref": "#/$defs/identifier"
        },
        "providerInstance": {
          "$ref": "#/$defs/identifier"
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredConfig": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configField"
          }
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "adapter",
        "capabilityKeys",
        "configuration",
        "enablement",
        "health",
        "effective",
        "operations",
        "requiredConfig",
        "links"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "adapter": {
          "$ref": "#/$defs/identifier"
        },
        "capabilityKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityKey"
          }
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "enablement": {
          "$ref": "#/$defs/enablement"
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "effective": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredConfig": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configField"
          }
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  }
}
